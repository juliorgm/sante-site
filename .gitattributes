# Normaliza fim de linha: o repositório guarda sempre LF.
# Isso evita que um save no Windows marque 35 arquivos como modificados
# sem que uma linha de conteúdo tenha mudado.
* text=auto eol=lf

# Binários — nunca normalizar
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.pdf  binary
*.woff  binary
*.woff2 binary
